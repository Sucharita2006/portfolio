# Every variable here is optional. The site builds, runs, and serves every route
# with this file empty — see document/BUILD_SPEC.md section 5.5.
# Copy to .env.local and fill in only what you need.

# Postgres (Neon). Absent: no view counts and no stored contact submissions.
# The pages render and the contact form still delivers.
DATABASE_URL=

# Salt for hashing submitter IP addresses before they are stored.
# Absent: a build-time constant is used, which means the hash is reversible by
# anyone who can guess an address. Set this in production.
IP_HASH_SALT=

# Resend. Absent: the contact route validates, rate-limits, and logs the message
# to the server console instead of emailing it.
RESEND_API_KEY=
CONTACT_TO_EMAIL=sucharita.chatterjee100@gmail.com
CONTACT_FROM_EMAIL=portfolio@yourdomain.com

# GitHub read-only API. Absent: 60 requests/hour instead of 5000, which is ample
# at hourly revalidation. Create a classic token with NO scopes at
# github.com/settings/tokens
GITHUB_TOKEN=

# Canonical origin for metadata, sitemap, and Open Graph URLs.
# Absent: falls back to the Vercel deployment URL, then http://localhost:3000
NEXT_PUBLIC_SITE_URL=
